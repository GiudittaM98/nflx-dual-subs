{
  // TypeScript qui serve solo per il controllo dei tipi (npm run typecheck).
  // La compilazione vera la fa esbuild (vedi build.mjs), che ignora i tipi.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "types": ["chrome"],
    "skipLibCheck": true
  },
  "include": ["src"]
}
